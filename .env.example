# Copie para .env e preencha. Nunca faça commit do .env.

ENVIRONMENT=development

# --- Banco (docker compose monta o DATABASE_URL a partir destes) ---
POSTGRES_DB=arvores
POSTGRES_USER=arvores
POSTGRES_PASSWORD=troque-esta-senha
# Só para rodar fora do Docker:
# DATABASE_URL=postgresql+asyncpg://arvores:troque-esta-senha@localhost:5432/arvores

# --- URL pública PERMANENTE ---
# É o que vai impresso no QR das placas: {BASE_URL}/a/{public_id}.
# Depois de imprimir, NÃO PODE MUDAR. Use um domínio próprio/subdomínio do IFSul.
BASE_URL=http://localhost:8000

# --- Mapa ---
# PLACEHOLDER: troque pela coordenada real do campus ("lat,lng").
MAP_CENTER=-28.2620,-52.4060
MAP_ZOOM=18
TIMEZONE=America/Sao_Paulo

# --- Segurança (gere com: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
SECRET_KEY=gere-uma-chave-aleatoria-longa
IP_HASH_SALT=gere-outro-valor-aleatorio-longo
ACCESS_TOKEN_EXPIRE_MINUTES=720
# true só atrás de um proxy reverso confiável (nginx/caddy) que define X-Forwarded-For
TRUST_PROXY_HEADERS=false
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Regas públicas ---
MIN_WATERING_INTERVAL_HOURS=3
WATERING_RATE_LIMIT_COUNT=10
WATERING_RATE_LIMIT_WINDOW_MINUTES=60
# Fração do intervalo a partir da qual o selo fica amarelo
BADGE_WARN_RATIO=0.75

# --- Uploads ---
MAX_UPLOAD_MB=10

# --- Admin inicial (criado pelo seed; troque a senha depois) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha-do-admin
